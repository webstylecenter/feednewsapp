{
  "manifest_version": 3,
  "name": "FeedNews Save & Reader",
  "version": "2.1.0",
  "description": "Save pages to FeedNews and allow frame-blocked pages inside the FeedNews reader.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save to FeedNews",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "feednews_frame_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
